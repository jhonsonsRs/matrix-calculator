  <property name="styleSheet">
   <string notr="true">/* QMainWindow ou widget raiz */
QWidget#centralWidget {
    background-color: #1a1a2e;
}

/* Labels de título das matrizes */
QLabel#labelMatrizA, QLabel#labelMatrizB {
    color: #7c6af0;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
}

QLabel#labelTitle {
    color: #e2e8f0;
    font-size: 14px;
    letter-spacing: 3px;
}

/* Frames/GroupBox que envolvem cada matriz */
QGroupBox {
    background-color: #16213e;
    border: 1px solid #2d3561;
    border-radius: 12px;
    padding: 12px;
    color: #a8b4d8;
}

/* Campos de entrada das células */
QLineEdit {
    background-color: #1a1a2e;
    border: 1px solid #2d3561;
    border-radius: 4px;
    color: #a8b4d8;
    font-family: &quot;Courier New&quot;;
    font-size: 13px;
    padding: 4px;
}
QLineEdit:focus {
    border-color: #7c6af0;
    color: #e2e8f0;
}

/* SpinBoxes de rows/cols */
QSpinBox {
    background-color: #0f3460;
    border: 1px solid #2d3561;
    border-radius: 6px;
    color: #7c6af0;
    font-size: 15px;
    font-weight: bold;
    padding: 4px 8px;
}
QSpinBox::up-button, QSpinBox::down-button {
    background: #2d3561;
    border-radius: 3px;
}

/* Botões de operação A+B, A-B, A*B */
QPushButton#btnAdd {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #7c6af0, stop:1 #5a4fcf);
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 16px;
}
QPushButton#btnSub {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #e86c6c, stop:1 #c94040);
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 16px;
}
QPushButton#btnMul {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #4caf87, stop:1 #2e8b6a);
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 16px;
}
QPushButton:hover { opacity: 0.85; }

/* Botões secundários (Transposta, Det, Multiplicar por) */
QPushButton#btnTransposta, QPushButton#btnDet, QPushButton#btnScalar {
    background-color: transparent;
    border: 1px solid #2d3561;
    border-radius: 6px;
    color: #a8b4d8;
    font-size: 11px;
    padding: 5px 10px;
}
QPushButton#btnTransposta:hover, QPushButton#btnDet:hover {
    background-color: #2d3561;
    color: #e2e8f0;
}

/* Área de resultado */
QTableWidget, QTextEdit#resultArea {
    background-color: #0f3460;
    border: 1px solid rgba(76, 175, 135, 0.25);
    border-radius: 8px;
    color: #4caf87;
    font-family: &quot;Courier New&quot;;
    font-size: 13px;
    font-weight: bold;
    gridline-color: #2d3561;
}</string>
